# Required: PostgreSQL connection string.
# Example: postgres://user:password@localhost:5432/energy_manager
DATABASE_URL=

# Optional during setup. Set this Tibber personal access token to fetch real prices.
# Most users should leave this empty. It is only needed when the account has multiple homes.
TIBBER_ACCESS_TOKEN=
TIBBER_HOME_ID=
TESLA_VEHICLE_ID=
TESLA_REGION=eu
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=http://localhost:3000/api/auth/tesla/callback
TIBBER_OAUTH_CLIENT_ID=
TIBBER_OAUTH_CLIENT_SECRET=
TIBBER_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/tibber/callback
TOKEN_ENCRYPTION_KEY=

ELECTRICITY_PRICE_PROVIDER=mock-electricity-price
HOME_TELEMETRY_PROVIDER=mock-home-telemetry
VEHICLE_STATE_PROVIDER=tesla

# Use planning-only until a charger provider is intentionally selected.
CHARGER_PROVIDER=planning-only

WEATHER_FORECAST_PROVIDER=open-meteo
USER_MODE=safe
SOC_BUFFER_PERCENT=15
START_EARLY_MINUTES=90
ALLOW_UNDERCHARGE_RISK=false
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
SOLAR_PANEL_TILT_DEGREES=
SOLAR_PANEL_AZIMUTH_DEGREES=
DEPARTURE_TIME=08:00
MINIMUM_SOC_PERCENT=65
MAXIMUM_SOC_PERCENT=80
BATTERY_CAPACITY_KWH=75
CHARGER_POWER_KW=11
CHARGING_EFFICIENCY=0.9
PORT=3000
