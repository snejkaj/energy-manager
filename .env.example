# Required: PostgreSQL connection string.
# Example: postgres://user:password@localhost:5432/energy_manager
DATABASE_URL=

# Optional during setup. Without this, the app shows a Tibber setup message and uses mock prices.
TIBBER_ACCESS_TOKEN=
TIBBER_HOME_ID=

ELECTRICITY_PRICE_PROVIDER=mock-electricity-price
HOME_TELEMETRY_PROVIDER=mock-home-telemetry

# Use planning-only until a charger provider is intentionally selected.
CHARGER_PROVIDER=planning-only

WEATHER_FORECAST_PROVIDER=open-meteo
USER_MODE=safe
SOC_BUFFER_PERCENT=15
START_EARLY_MINUTES=90
ALLOW_UNDERCHARGE_RISK=false
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
SOLAR_PANEL_TILT_DEGREES=
SOLAR_PANEL_AZIMUTH_DEGREES=
PORT=3000
